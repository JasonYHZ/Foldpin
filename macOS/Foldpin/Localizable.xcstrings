    "To put a collected note back on the desktop, use its Actions menu on the shelf. A note already on the desktop can be located from the same menu." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um abgelegte Notizen auf den Schreibtisch zurückzuholen, nutze ihr Aktionsmenü in der Ablage. Bereits sichtbare Notizen lassen sich dort auch finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To put a collected note back on the desktop, use its Actions menu on the shelf. A note already on the desktop can be located from the same menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para devolver una nota al escritorio, usa su menú Acciones en la estantería. Una nota ya abierta puede localizarse desde ese mismo menú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour remettre une note rangée sur le bureau, utilisez son menu Actions dans l’étagère. Une note déjà sur le bureau peut être localisée depuis ce même menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収納済みのメモをデスクトップに戻すには、シェルフの操作メニューを使います。すでにデスクトップにあるメモも同じメニューから表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관한 메모를 데스크탑으로 돌리려면 보관함의 동작 메뉴를 사용하세요. 이미 데스크탑에 있는 메모도 같은 메뉴에서 찾을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要把已收纳纸片放回桌面，可使用右侧栏的「操作」菜单；纸片已在桌面上时，也可以从这里定位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要把已收納紙片放回桌面，可使用右側欄的「操作」選單；紙片已在桌面上時，也可以從這裡定位。"
          }
        }
      }
    },
