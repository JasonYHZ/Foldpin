    "All notes and attachments will be copied and checked. The original folder will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Notizen und Anhänge werden kopiert und geprüft. Der ursprüngliche Ordner bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All notes and attachments will be copied and checked. The original folder will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se copiarán y verificarán todas las notas y adjuntos. Se conservará la carpeta original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les notes et pièces jointes seront copiées et vérifiées. Le dossier d’origine sera conservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのメモと添付ファイルをコピーして検証します。元のフォルダは保持されます。"
