    "Foldpin will open the library saved in its default location and upgrade it automatically if needed. The original files are kept. Your current library will not be moved or merged." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldpin öffnet die Mediathek am Standardort und aktualisiert sie bei Bedarf. Originaldateien bleiben erhalten. Die aktuelle Mediathek wird weder verschoben noch zusammengeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldpin will open the library saved in its default location and upgrade it automatically if needed. The original files are kept. Your current library will not be moved or merged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldpin abrirá la biblioteca de la ubicación predeterminada y la actualizará si es necesario. Conserva los archivos originales. La biblioteca actual no se mueve ni se combina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldpin ouvre la bibliothèque à son emplacement par défaut et la met à niveau si nécessaire. Les originaux sont conservés. La bibliothèque actuelle n’est ni déplacée ni fusionnée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトの場所のライブラリを開き、必要に応じて自動更新します。元のファイルは保持されます。現在のライブラリは移動・統合されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 위치의 라이브러리를 열고 필요하면 자동으로 업그레이드합니다. 원본 파일은 유지됩니다. 현재 라이브러리는 이동하거나 병합하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将自动打开默认位置中保存的资料库，必要时自动升级并保留原文件。当前资料库不会迁移或合并，无需选择文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將自動打開預設位置中儲存的資料庫，必要時自動升級並保留原檔案。目前資料庫不會遷移或合併，無需選擇資料夾。"
          }
        }
      }
    },
