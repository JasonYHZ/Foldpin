    "Finish importing or recording and check that all resource files are available. Existing notes and exports are unchanged." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende Import oder Aufnahme und prüfe alle Ressourcendateien. Bestehende Notizen und Exporte bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish importing or recording and check that all resource files are available. Existing notes and exports are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina la importación o grabación y comprueba los recursos. Las notas y exportaciones existentes no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez l’importation ou l’enregistrement et vérifiez les ressources. Les notes et exports existants restent inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込みや録音を完了し、すべてのリソースが利用可能か確認してください。既存のメモと書き出しファイルは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기나 녹음을 완료하고 모든 리소스 파일이 있는지 확인하세요. 기존 메모와 내보낸 파일은 변경되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先完成导入或录音，并确认所有资源文件仍然可用。原有纸片和导出文件不会被覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先完成匯入或錄音，並確認所有資源檔案仍然可用。原有紙片和匯出檔案不會被覆蓋。"
          }
        }
      }
    },
