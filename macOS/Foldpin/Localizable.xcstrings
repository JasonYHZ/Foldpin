    "Export one note from its Actions menu, or select notes on the shelf and use the right sidebar’s actions. Choose Markdown or HTML. Notes with attachments, and multi-note exports, are packaged as ZIP archives with their resources." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export one note from its Actions menu, or select notes on the shelf and use the right sidebar’s actions. Choose Markdown or HTML. Notes with attachments, and multi-note exports, are packaged as ZIP archives with their resources."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单张纸片可从「操作」菜单导出；在收纳窗口选中单张或多张后，也可以从右侧栏操作。支持 Markdown 和 HTML；含附件或多张纸片时，会将正文与资源打包为 ZIP。"
          }
        }
      }
    },
