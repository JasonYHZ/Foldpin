    "Open the shelf from the menu bar icon → Open Shelf. Collecting preserves content, appearance and the desktop layout; it does not delete the note." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Ablage über das Menüleistensymbol → Ablage öffnen. Ablegen erhält Inhalt, Aussehen und Schreibtischlayout; die Notiz wird nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the shelf from the menu bar icon → Open Shelf. Collecting preserves content, appearance and the desktop layout; it does not delete the note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la estantería desde el icono → Abrir estantería. Guardar conserva contenido, apariencia y disposición; no elimina la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’étagère via l’icône → Ouvrir l’étagère. Ranger conserve contenu, apparence et disposition du bureau ; la note n’est pas supprimée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのアイコン → シェルフを開く、で収納したメモを表示できます。収納しても内容、外観、デスクトップの配置は保持され、メモは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 아이콘 → 보관함 열기로 메모를 찾으세요. 보관해도 내용, 모양 및 데스크탑 배치가 유지되며 메모는 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击菜单栏图标 →「打开收纳」就能找回纸片。收纳会保留内容、外观和桌面布局，不等于删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊選單欄圖標 →「打開收納」就能找回紙片。收納會保留內容、外觀和桌面佈局，不等於刪除。"
          }
        }
      }
    },
