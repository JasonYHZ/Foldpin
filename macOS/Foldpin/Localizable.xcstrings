    "Use / to insert a recording or import supported audio and video. Microphone permission is requested only when you start recording. Finish a recording before moving to another library." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze / für Aufnahmen oder Audio-/Videoimport. Mikrofonzugriff wird erst beim Aufnahmestart angefragt. Beende Aufnahmen vor einem Mediathekwechsel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use / to insert a recording or import supported audio and video. Microphone permission is requested only when you start recording. Finish a recording before moving to another library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa / para grabar o importar audio y vídeo compatibles. El permiso del micrófono solo se pide al iniciar una grabación. Finalízala antes de cambiar de biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez / pour enregistrer ou importer de l’audio et de la vidéo. Le microphone n’est demandé qu’au démarrage d’un enregistrement. Terminez-le avant de changer de bibliothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/ から録音や対応する音声・動画の読み込みができます。マイクへのアクセスは録音開始時のみ求めます。ライブラリの変更前に録音を完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/로 녹음을 넣거나 지원되는 오디오와 비디오를 가져오세요. 마이크 권한은 녹음 시작 시에만 요청됩니다. 다른 라이브러리로 이동하기 전에 녹음을 완료하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 / 可以开始录音，或导入支持的音频、视频。只有主动开始录音时才会请求麦克风权限。切换资料库前，请先完成录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通過 / 可以開始錄音，或匯入支援的音訊、影片。只有主動開始錄音時才會請求麥克風權限。切換資料庫前，請先完成錄音。"
          }
        }
      }
    },
    "Use Actions at the bottom right for pinning, folding, copying all content, duplicating, changing the icon or color, and exporting." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze die Aktionen unten rechts für Anheften, Einklappen, Gesamtkopie, Duplizieren, Symbol- und Farbwechsel sowie Export."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Actions at the bottom right for pinning, folding, copying all content, duplicating, changing the icon or color, and exporting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Acciones abajo a la derecha para fijar, plegar, copiar todo, duplicar, cambiar icono o color y exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Actions en bas à droite pour épingler, replier, tout copier, dupliquer, changer l’icône ou la couleur et exporter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右下の操作メニューで固定、折りたたみ、全内容のコピー、複製、アイコン・色の変更、書き出しができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 아래 동작 메뉴에서 고정, 접기, 전체 복사, 복제, 아이콘/색상 변경 및 내보내기를 할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右下角「操作」可以置顶、折叠、复制全部内容、创建副本、更换图标或颜色，以及导出纸片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右下角「操作」可以置頂、折疊、複製全部內容、創建副本、更換圖標或顏色，以及匯出紙片。"
          }
        }
      }
    },
    "Use Command or Control with a letter, number, arrow, or punctuation key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Command oder Control mit Buchstaben, Zahlen, Pfeilen oder Satzzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Command or Control with a letter, number, arrow, or punctuation key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Comando o Control con una letra, número, flecha o signo de puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Commande ou Contrôle avec une lettre, un chiffre, une flèche ou une ponctuation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
