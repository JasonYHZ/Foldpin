    "Click a card to edit it directly in the right sidebar. There is no preview/edit switch. Drag either sidebar divider to adjust its width." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke eine Karte an, um sie direkt rechts zu bearbeiten. Kein Wechsel zwischen Vorschau und Bearbeitung. Ziehe die Trennlinien, um die Breite anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a card to edit it directly in the right sidebar. There is no preview/edit switch. Drag either sidebar divider to adjust its width."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en una tarjeta para editarla en la barra lateral derecha, sin cambiar de modo. Arrastra los separadores para ajustar el ancho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une carte pour la modifier directement dans la barre latérale droite, sans changer de mode. Faites glisser les séparateurs pour ajuster leur largeur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードをクリックすると右サイドバーで直接編集できます。プレビューと編集の切り替えはありません。左右の区切りをドラッグして幅を調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드를 클릭하면 오른쪽 사이드바에서 바로 편집할 수 있습니다. 미리보기/편집 전환이 없습니다. 양쪽 구분선을 드래그하여 너비를 조절하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击卡片，就能直接在右侧栏编辑，不需要切换预览或编辑模式。拖动左右侧栏的分隔线可以调整宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊卡片，就能直接在右側欄編輯，不需要切換預覽或編輯模式。拖動左右側欄的分隔線可以調整寬度。"
          }
        }
      }
    },
    "Click and press a shortcut. Escape cancels; Delete clears." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken und Kurzbefehl drücken. Escape bricht ab, Delete löscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click and press a shortcut. Escape cancels; Delete clears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic y pulsa un atajo. Escape cancela; Suprimir lo borra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez et appuyez sur un raccourci. Échap annule ; Suppr efface."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックしてキーの組み合わせを押してください。Esc でキャンセル、Delete で解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭한 후 단축키를 누르세요. Esc로 취소하고 Delete로 지웁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击后按下组合键。Esc 取消，Delete 清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊後按下組合鍵。Esc 取消，Delete 清除。"
          }
        }
      }
    },
    "Click anywhere in the body and start typing. Notes have no separate title field: their first nonempty line is the title shown on the shelf." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke in den Text und schreibe los. Es gibt kein separates Titelfeld: Die erste nicht leere Zeile dient als Titel in der Ablage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click anywhere in the body and start typing. Notes have no separate title field: their first nonempty line is the title shown on the shelf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el texto y empieza a escribir. No hay un título separado: la primera línea no vacía es el título de la estantería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez dans le texte et commencez à écrire. Il n’y a pas de titre séparé : la première ligne non vide sert de titre dans l’étagère."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本文をクリックして入力します。独立したタイトル欄はなく、最初の空でない行がシェルフのタイトルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본문을 클릭하고 입력하세요. 별도 제목 필드는 없으며, 비어 있지 않은 첫 줄이 보관함의 제목이 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击正文就可以开始输入。纸片不需要单独填写标题，收纳窗口会用正文第一个非空行作为标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊正文就可以開始輸入。紙片不需要單獨填寫標題，收納窗口會用正文第一個非空行作為標題。"
          }
        }
      }
    },
    "Click for actions; drag to reorder." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken für Aktionen, ziehen zum Umsortieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click for actions; drag to reorder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para ver acciones; arrastra para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez pour les actions ; faites glisser pour réorganiser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックで操作、ドラッグで並べ替え。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하여 동작 열기, 드래그하여 순서 변경."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击打开菜单，拖动调整顺序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊打開選單，拖動調整順序。"
          }
        }
      }
    },
    "Click the magnifying glass to search. The toolbar switches between grid and list views; the filter and sort menus narrow results and control date grouping." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf die Lupe zum Suchen. In der Symbolleiste wechselst du zwischen Raster und Liste; Filter und Sortierung steuern Ergebnisse und Datumsgruppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the magnifying glass to search. The toolbar switches between grid and list views; the filter and sort menus narrow results and control date grouping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en la lupa para buscar. La barra permite alternar cuadrícula y lista; los filtros y la ordenación controlan los resultados y la agrupación por fecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur la loupe pour chercher. La barre d’outils propose grille et liste ; les menus de filtre et de tri règlent les résultats et le regroupement par date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虫眼鏡をクリックして検索します。ツールバーでグリッドとリストを切り替え、フィルタと並べ替えで結果や日付のグループを調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돋보기를 클릭하여 검색하세요. 도구 막대에서 격자와 목록을 전환하고, 필터 및 정렬 메뉴로 결과와 날짜 그룹을 조정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击放大镜按钮展开搜索；工具栏可以切换网格和列表。类型筛选与排序菜单可缩小范围，也可以控制日期分组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊放大鏡按鈕展開搜索；工具欄可以切換格狀和列表。類型篩選與排序選單可縮小範圍，也可以控制日期分組。"
          }
        }
      }
    },
