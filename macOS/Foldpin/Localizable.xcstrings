        }
      }
    },
    "Some local resources could not be copied. Their original links were kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige lokale Ressourcen konnten nicht kopiert werden. Ihre ursprünglichen Links bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
