        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 찾기 — 오른쪽 위에서 보관하세요. 메뉴 막대에서 보관함을 열어 검색하고 편집하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
