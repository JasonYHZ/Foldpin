          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron copiar algunos recursos locales. Se conservaron sus enlaces originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines ressources locales n’ont pas pu être copiées. Les liens d’origine sont conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のローカルリソースをコピーできませんでした。元のリンクは保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 로컬 리소스를 복사하지 못했습니다. 원래 링크는 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分本地附件无法复制，已保留原始链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分本地附件無法複製，已保留原始連結。"
          }
        }
      }
    },
    "Standalone local images become image blocks. Standalone file links, including audio and video, become file attachments. Inline resources and unsupported syntax stay as source text." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleinstehende lokale Bilder werden Bildblöcke. Alleinstehende Dateilinks, auch Audio und Video, werden Anhänge. Inline-Ressourcen und nicht unterstützte Syntax bleiben Quelltext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standalone local images become image blocks. Standalone file links, including audio and video, become file attachments. Inline resources and unsupported syntax stay as source text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes locales independientes se convierten en bloques de imagen. Los enlaces de archivo independientes, incluidos audio y vídeo, se convierten en adjuntos. Los recursos en línea y la sintaxis no compatible se conservan como texto fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images locales isolées deviennent des blocs image. Les liens de fichiers isolés, audio et vidéo compris, deviennent des pièces jointes. Les ressources en ligne et syntaxes non prises en charge restent en texte source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単独行のローカル画像は画像ブロックになります。音声や動画を含む単独のファイルリンクは添付ファイルになります。行内リソースと非対応の構文は元のテキストとして保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "독립된 로컬 이미지는 이미지 블록이 됩니다. 오디오와 비디오를 포함한 독립 파일 링크는 첨부 파일이 됩니다. 인라인 리소스와 지원하지 않는 구문은 원문으로 유지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独成行的本地图片会转成图片区块；文件链接（含音视频）会转成文件附件。行内资源和不支持的语法保留为原文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨成行的本地圖片會轉成圖片區塊；檔案連結（含音影片）會轉成檔案附件。行內資源和不支援的語法保留為原文。"
          }
        }
      }
    },
