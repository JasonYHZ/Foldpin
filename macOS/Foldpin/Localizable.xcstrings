    "Highlighting is paused for long code blocks. You can still edit and copy all content." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei langen Codeblöcken wird die Hervorhebung pausiert. Bearbeiten und Kopieren bleiben möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highlighting is paused for long code blocks. You can still edit and copy all content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resaltado se pausa en bloques largos. Puedes seguir editando y copiando todo el contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coloration est suspendue pour les longs blocs de code. Vous pouvez toujours modifier et tout copier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長いコードブロックではハイライトを一時停止します。編集と全内容のコピーは引き続き可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 코드 블록은 강조 표시가 일시 중지됩니다. 편집과 전체 내용 복사는 계속할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长代码块已暂停高亮，仍可编辑和复制全部内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長程式碼塊已暫停高亮，仍可編輯和複製全部內容。"
          }
        }
      }
    },
    "Historical revisions, recovery copies, undo and clipboard can still need attachments. Cleanup is unavailable until their references and sharing history can be verified." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisionen, Wiederherstellungskopien, Widerrufen und Zwischenablage können Anhänge benötigen. Bereinigung ist erst nach Prüfung der Verweise und Freigabehistorie verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historical revisions, recovery copies, undo and clipboard can still need attachments. Cleanup is unavailable until their references and sharing history can be verified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial, las copias de recuperación, deshacer y el portapapeles pueden necesitar adjuntos. La limpieza no estará disponible hasta verificar sus referencias e historial de uso compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique, les copies de récupération, l’annulation et le presse-papiers peuvent encore utiliser les pièces jointes. Le nettoyage reste indisponible tant que ces références et le partage ne sont pas vérifiables."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴、復旧用コピー、取り消し、クリップボードから添付ファイルを参照する場合があります。参照と共有履歴を検証できるまでクリーンアップは利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수정 기록, 복구 사본, 실행 취소 및 클립보드가 첨부 파일을 사용할 수 있습니다. 참조와 공유 기록을 검증할 수 있을 때까지 정리는 사용할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史修订、恢复副本、撤销和剪贴板仍可能使用附件。在完整引用与共享记录可核实前，暂不开放资源清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歷史修訂、恢復副本、復原和剪貼簿仍可能使用附件。在完整引用與共享記錄可覈實前，暫不開放資源清理。"
          }
        }
      }
    },
