    "The attachment could not be opened. Its file may be missing or no app is available." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anhang konnte nicht geöffnet werden. Die Datei fehlt möglicherweise oder es gibt keine passende App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The attachment could not be opened. Its file may be missing or no app is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir el adjunto. Puede faltar el archivo o no haber una app disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir la pièce jointe. Le fichier est peut-être manquant ou aucune app n’est disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルを開けません。ファイルが見つからないか、対応するアプリがない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첨부 파일을 열 수 없습니다. 파일이 없거나 사용할 앱이 없을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开附件，文件可能已丢失，或没有可打开它的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法打開附件，檔案可能已丟失，或沒有可打開它的應用。"
          }
        }
      }
    },
    "The attachments could not be saved. Their files are kept; retry saving the note." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anhänge konnten nicht gespeichert werden. Die Dateien bleiben erhalten; speichere die Notiz erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The attachments could not be saved. Their files are kept; retry saving the note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar los adjuntos. Los archivos se conservan; reintenta guardar la nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces jointes n’ont pas pu être enregistrées. Les fichiers sont conservés ; réessayez de sauvegarder la note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添付ファイルを保存できませんでした。ファイルは保持されています。メモの保存を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첨부 파일을 저장하지 못했습니다. 파일은 유지됩니다. 메모 저장을 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件未能保存，文件已保留，请重试保存纸片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件未能儲存，檔案已保留，請重試儲存紙片。"
          }
        }
      }
    },
    "The collect button at the top right stores the note on the shelf. Closing a note with content also collects it. Closing a blank note moves it to Recently Deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ablagetaste oben rechts legt die Notiz ab. Schließen einer Notiz mit Inhalt legt sie ebenfalls ab. Leere Notizen werden nach „Zuletzt gelöscht“ verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The collect button at the top right stores the note on the shelf. Closing a note with content also collects it. Closing a blank note moves it to Recently Deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón superior derecho guarda la nota en la estantería. Cerrar una nota con contenido también la guarda. Cerrar una vacía la mueve a Eliminadas recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton en haut à droite range la note dans l’étagère. Fermer une note avec du contenu la range aussi. Fermer une note vide la déplace dans Suppressions récentes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の収納ボタンでメモをシェルフに移せます。内容のあるメモを閉じても収納されます。空白のメモを閉じると「最近削除した項目」に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 위 보관 버튼으로 메모를 보관함에 넣습니다. 내용이 있는 메모를 닫아도 보관됩니다. 빈 메모를 닫으면 최근 삭제된 항목으로 이동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上角的收起按钮可以把纸片收进收纳窗口。有内容的纸片点击左上角关闭或按 ⌘W，也会收纳；空白纸片关闭后会进入最近删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上角的收起按鈕可以把紙片收進收納窗口。有內容的紙片點擊左上角關閉或按 ⌘W，也會收納；空白紙片關閉後會進入最近刪除。"
          }
        }
      }
    },
