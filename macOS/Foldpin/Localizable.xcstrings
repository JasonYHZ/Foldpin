    "Changes save automatically. If a save error appears, keep the note open and use Retry before quitting." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen werden automatisch gespeichert. Bei einem Speicherfehler die Notiz offen lassen und vor dem Beenden erneut speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes save automatically. If a save error appears, keep the note open and use Retry before quitting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se guardan automáticamente. Si aparece un error, mantén la nota abierta y reintenta guardar antes de salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications sont enregistrées automatiquement. En cas d’erreur, gardez la note ouverte et réessayez avant de quitter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は自動保存されます。保存エラーが表示されたら、メモを開いたまま再試行し、保存を確認してから終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항은 자동 저장됩니다. 저장 오류가 나타나면 메모를 열어 둔 채 재시도하고 저장 후 종료하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容会自动保存。如果出现保存失败提示，请保留纸片窗口，点击重试，确认保存后再退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內容會自動儲存。如果出現儲存失敗提示，請保留紙片窗口，點擊重試，確認儲存後再退出。"
          }
        }
      }
    },
