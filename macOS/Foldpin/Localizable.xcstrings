    "Capture a thought. Keep it beside you. Collect it for later." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedanken festhalten. Daneben behalten. Für später ablegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture a thought. Keep it beside you. Collect it for later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura una idea. Tenla cerca. Guárdala para después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez une idée. Gardez-la près de vous. Rangez-la pour plus tard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思いつきを記録。そばに置いて、あとで見返す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각을 기록하고, 곁에 두고, 나중을 위해 보관하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随手记下来，贴在身边，收起来随时找回。"
