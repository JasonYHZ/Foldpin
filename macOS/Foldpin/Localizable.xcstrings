    "Type / to choose a heading, checklist, code block, table, image or media block. You can also paste Markdown to convert supported formatting into editable blocks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe / für Überschriften, Checklisten, Code, Tabellen, Bilder oder Medien. Eingesetztes Markdown wird mit unterstützten Formaten zu bearbeitbaren Blöcken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
