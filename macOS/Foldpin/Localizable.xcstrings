    "A previous storage change was interrupted. Your original library is kept. Retry the move, or open the completed destination." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzte Speicheränderung wurde unterbrochen. Die ursprüngliche Mediathek bleibt erhalten. Wiederhole den Umzug oder öffne das fertige Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A previous storage change was interrupted. Your original library is kept. Retry the move, or open the completed destination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se interrumpió el cambio de ubicación. La biblioteca original se conserva. Reintenta el traslado o abre el destino completado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement d’emplacement a été interrompu. La bibliothèque d’origine est conservée. Réessayez le déplacement ou ouvrez la destination terminée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の保存先変更が中断されました。元のライブラリは保持されています。移動を再試行するか、コピー済みの保存先を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 저장 위치 변경이 중단되었습니다. 원본 라이브러리는 유지됩니다. 이동을 재시도하거나 복사가 끝난 대상을 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次更改存储位置时中断了，原资料库仍保留。可以重试迁移，或打开已完成的目标资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次更改儲存位置時中斷了，原資料庫仍保留。可以重試遷移，或打開已完成的目標資料庫。"
          }
        }
      }
    },
