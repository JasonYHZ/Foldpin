    "More — Use Actions below for colors, export and deletion. Appearance and shortcuts are in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr — Nutze unten die Aktionen für Farben, Export und Löschen. Erscheinungsbild und Kurzbefehle findest du in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
