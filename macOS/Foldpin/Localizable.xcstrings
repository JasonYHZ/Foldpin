    "Only the background fades. Text and controls stay opaque. Glass blur is managed by macOS." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Hintergrund wird transparent. Text und Bedienelemente bleiben deckend. macOS steuert die Glasunschärfe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the background fades. Text and controls stay opaque. Glass blur is managed by macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se atenúa el fondo. El texto y los controles siguen opacos. macOS gestiona el desenfoque del vidrio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le fond s’estompe. Le texte et les commandes restent opaques. macOS gère le flou du verre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景のみを薄くします。文字とボタンは不透明のままです。ガラスのぼかしは macOS が管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경만 흐려집니다. 텍스트와 컨트롤은 불투명하게 유지됩니다. 유리 흐림은 macOS에서 관리합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅调整背景，文字和按钮保持清晰。玻璃模糊由 macOS 自动处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅調整背景，文字和按鈕保持清晰。玻璃模糊由 macOS 自動處理。"
          }
        }
      }
    },
    "Only the text above will be copied." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der obige Text wird kopiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the text above will be copied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se copiará el texto de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le texte ci-dessus sera copié."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上のテキストのみコピーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 텍스트만 복사됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会复制上方显示的文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會複製上方顯示的文字。"
          }
        }
      }
    },
    "Only these targets will be used. Changes made after this request will cancel the operation." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur diese Ziele werden verwendet. Änderungen nach dieser Anfrage brechen den Vorgang ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only these targets will be used. Changes made after this request will cancel the operation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se usarán estos elementos. Los cambios posteriores a esta solicitud cancelarán la operación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules ces cibles seront utilisées. Toute modification après cette demande annulera l’opération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに示す対象のみ使用します。要求後に変更があった場合は操作をキャンセルします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대상만 사용합니다. 요청 후 변경 사항이 있으면 작업이 취소됩니다."
