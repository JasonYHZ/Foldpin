          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más — Usa Acciones abajo para colores, exportación y eliminación. La apariencia y los atajos están en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus — Les actions ci-dessous proposent couleurs, export et suppression. Apparence et raccourcis sont dans les réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その他 — 下の操作で色、書き出し、削除を選べます。外観とショートカットは設定にあります。"
