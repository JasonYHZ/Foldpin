          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call history stays in memory and contains no note content, file paths or access keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de llamadas se mantiene en memoria y no contiene notas, rutas de archivos ni claves de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
