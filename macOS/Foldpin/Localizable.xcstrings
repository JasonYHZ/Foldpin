    "Paste or drag a local image or file into a note to keep a copy with it. Images can have captions and can be resized. File attachments can be opened or exported from their menus." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze oder ziehe ein lokales Bild oder eine Datei in eine Notiz, um eine Kopie zu behalten. Bilder unterstützen Unterschriften und Größenänderung. Anhänge lassen sich über ihre Menüs öffnen oder exportieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste or drag a local image or file into a note to keep a copy with it. Images can have captions and can be resized. File attachments can be opened or exported from their menus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega o arrastra una imagen o archivo local a una nota para guardar una copia. Puedes añadir pies y redimensionar imágenes. Los adjuntos se abren o exportan desde sus menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez ou glissez une image ou un fichier local dans une note pour en garder une copie. Les images acceptent légendes et redimensionnement. Les pièces jointes s’ouvrent ou s’exportent par leur menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの画像やファイルをペーストまたはドラッグすると、メモにコピーを保存します。画像はキャプションとサイズを変更でき、添付ファイルはメニューから開く・書き出すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 이미지나 파일을 메모에 붙여넣거나 드래그하면 사본이 저장됩니다. 이미지에 설명을 추가하고 크기를 조절할 수 있습니다. 첨부 파일은 메뉴에서 열거나 내보낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把本地图片或文件粘贴、拖入纸片，就能保存一份副本。图片可以添加标题和调整显示大小，普通附件可以从菜单打开或导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把本地圖片或檔案貼上、拖入紙片，就能儲存一份副本。圖片可以添加標題和調整顯示大小，普通附件可以從選單打開或匯出。"
          }
        }
      }
