    "On other Macs, open the new location after this move. The original folder will not receive new changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne nach dem Umzug auf anderen Macs den neuen Ort. Der ursprüngliche Ordner erhält keine neuen Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On other Macs, open the new location after this move. The original folder will not receive new changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras el traslado, abre la nueva ubicación en los otros Mac. La carpeta original no recibirá nuevos cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le déplacement, ouvrez le nouvel emplacement sur les autres Mac. Le dossier d’origine ne recevra plus de modifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動後は他の Mac で新しい場所を開いてください。元のフォルダには今後の変更は保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 후 다른 Mac에서 새 위치를 여세요. 원본 폴더에는 새 변경 사항이 저장되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迁移后，请在其他 Mac 上打开新位置。原文件夹不会继续接收新的修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遷移後，請在其他 Mac 上打開新位置。原資料夾不會繼續接收新的修改。"
          }
        }
      }
    },
    "On this Mac" : {
      "extractionState" : "manual",
      "localizations" : {
