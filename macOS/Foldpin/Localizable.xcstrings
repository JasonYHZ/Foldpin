    "Show or shelve your note. Change the shortcut in the menu bar." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiz anzeigen oder ablegen. Ändere den Kurzbefehl in der Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show or shelve your note. Change the shortcut in the menu bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra o guarda tu nota. Cambia el atajo en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez ou rangez votre note. Changez le raccourci dans la barre des menus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモを表示または収納します。ショートカットはメニューバーで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 표시하거나 보관합니다. 메뉴 막대에서 단축키를 변경하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唤出或收起纸片。可在菜单栏更换快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喚出或收起紙片。可在選單欄更換快速鍵。"
          }
        }
      }
    },
    "Shown only now. Paste it into your client's Authorization header as Bearer followed by a space and this key. Keep it private." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur jetzt angezeigt. Setze im Authorization-Header des Clients Bearer, ein Leerzeichen und diesen Schlüssel ein. Halte ihn geheim."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown only now. Paste it into your client's Authorization header as Bearer followed by a space and this key. Keep it private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestra ahora. Pega en la cabecera Authorization del cliente Bearer, un espacio y esta clave. Mantenla privada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichée uniquement maintenant. Collez dans l’en-tête Authorization du client Bearer, une espace puis cette clé. Gardez-la privée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示は今回のみです。クライアントの Authorization ヘッダーに Bearer、半角スペース、このキーの順に貼り付けてください。公開しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 한 번만 표시됩니다. 클라이언트의 Authorization 헤더에 Bearer, 공백, 이 키 순서로 붙여넣으세요. 비공개로 보관하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥仅在此时显示。请在客户端的 Authorization 请求头中填写 Bearer、一个空格和此密钥，并妥善保管。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密鑰僅在此時顯示。請在客戶端的 Authorization 請求頭中填寫 Bearer、一個空格和此密鑰，並妥善保管。"
          }
        }
      }
    },
