    "A checked copy will be created in the location you choose next. The original library and its files will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am nächsten gewählten Ort wird eine geprüfte Kopie erstellt. Die ursprüngliche Mediathek und ihre Dateien bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A checked copy will be created in the location you choose next. The original library and its files will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se creará una copia verificada en la ubicación que elijas. Se conservarán la biblioteca original y sus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie vérifiée sera créée à l’emplacement choisi ensuite. La bibliothèque d’origine et ses fichiers seront conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に選択する場所に検証済みのコピーを作成します。元のライブラリとファイルは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 선택하는 위치에 검증된 사본을 만듭니다. 원본 라이브러리와 파일은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将在接下来选择的位置创建并校验一份副本，原资料库及其文件会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將在接下來選擇的位置創建並校驗一份副本，原資料庫及其檔案會保留。"
          }
        }
      }
    },
