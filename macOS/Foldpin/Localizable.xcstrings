    "Opening it switches to that library's saved contents. It does not move your current notes back or merge the two libraries." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Öffnen wechselst du zu den gespeicherten Inhalten dieser Mediathek. Aktuelle Notizen werden nicht verschoben und die Mediatheken nicht zusammengeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opening it switches to that library's saved contents. It does not move your current notes back or merge the two libraries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir se cambia al contenido guardado de esa biblioteca. No mueve tus notas actuales ni combina ambas bibliotecas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ouverture bascule vers le contenu enregistré de cette bibliothèque. Elle ne déplace pas vos notes et ne fusionne pas les bibliothèques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開くと、そのライブラリに保存された内容に切り替わります。現在のメモの移動や、ライブラリの統合は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열면 해당 라이브러리에 저장된 내용으로 전환됩니다. 현재 메모를 이동하거나 두 라이브러리를 병합하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后将切换到该资料库已保存的内容，不会把当前纸片迁回，也不会合并两个资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
