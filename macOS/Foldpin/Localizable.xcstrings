    "Partial result. Some files are unavailable or could not be read; the total is a lower bound." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilergebnis. Einige Dateien sind nicht verfügbar oder lesbar; die Summe ist eine Untergrenze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partial result. Some files are unavailable or could not be read; the total is a lower bound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultado parcial. Algunos archivos no están disponibles o no se pueden leer; el total es un mínimo."
          }
