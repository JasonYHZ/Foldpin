    "These notes will be removed from Recently Deleted and cannot be restored or undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Notizen werden aus „Zuletzt gelöscht“ entfernt und können nicht wiederhergestellt oder widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These notes will be removed from Recently Deleted and cannot be restored or undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas notas se quitarán de Eliminadas recientemente y no podrán restaurarse ni recuperarse con Deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
