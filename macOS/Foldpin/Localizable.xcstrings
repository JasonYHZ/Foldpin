    "Glass reflects your desktop and adapts to light, dark, and accessibility settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glas spiegelt deinen Schreibtisch wider und passt sich Hell, Dunkel und Bedienungshilfen an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glass reflects your desktop and adapts to light, dark, and accessibility settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vidrio refleja el escritorio y se adapta a los modos claro, oscuro y a los ajustes de accesibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verre reflète le bureau et s’adapte aux modes clair, sombre et aux réglages d’accessibilité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガラスはデスクトップを映し、明暗とアクセシビリティ設定に対応します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유리는 데스크탑 색상을 반영하며 라이트, 다크 및 손쉬운 사용 설정에 맞춰집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整张玻璃随桌面背景变化，并适配系统深浅色与辅助功能设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整張玻璃隨桌面背景變化，並適配系統深淺色與輔助功能設定。"
          }
        }
      }
    },
