    "Find later — Collect from the top right. Open Shelf from the menu bar to search and edit." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Später finden — Oben rechts ablegen. Öffne die Ablage über die Menüleiste zum Suchen und Bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find later — Collect from the top right. Open Shelf from the menu bar to search and edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra después — Guarda desde arriba a la derecha. Abre la estantería desde la barra de menús para buscar y editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouvez — Rangez en haut à droite. Ouvrez l’étagère dans la barre des menus pour chercher et modifier."
          }
