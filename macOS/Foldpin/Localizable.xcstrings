        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 보기 — 아래 동작에서 색상, 내보내기, 삭제를 선택하세요. 모양과 단축키는 설정에 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
